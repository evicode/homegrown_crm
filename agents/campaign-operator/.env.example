# Copy to .env or export these variables in the process that runs the operator.
# Never commit a real token.
CAMPAIGN_OPERATOR_MCP_URL=http://127.0.0.1/conversions/mcp
CAMPAIGN_OPERATOR_TOKEN=replace-with-a-scoped-local-integration-token
# Optional discovery source for the `find` command. Keep this server-side and never commit it.
GOOGLE_PLACES_API_KEY=replace-with-a-google-places-api-key
# Optional discovery source for the `find` command. Keep this server-side and never commit it.
FOURSQUARE_PLACES_API_KEY=
# Used only with OpenStreetMap discovery to locate the requested area. Enter your own token.
MAPBOX_ACCESS_TOKEN=
# Your managed or self-hosted Overpass endpoint. Required only for OpenStreetMap discovery.
OSM_OVERPASS_URL=
# Comma-separated discovery sources: google_places, foursquare, osm
CAMPAIGN_OPERATOR_SOURCES=google_places
# The dashboard writes this after you choose a campaign. You may leave it blank.
CAMPAIGN_OPERATOR_CAMPAIGN_ID=
