# Copy to .env or export these variables in the process that runs the operator.
# Never commit a real token.
CAMPAIGN_OPERATOR_MCP_URL=http://127.0.0.1/conversions/mcp
CAMPAIGN_OPERATOR_TOKEN=replace-with-a-scoped-local-integration-token
# Used only by the `find` command. Keep this server-side and never commit it.
GOOGLE_PLACES_API_KEY=replace-with-a-google-places-api-key
